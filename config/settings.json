{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "low",
  "theme": "santychuy-dark",
  "quietStartup": true,
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "opencode-go/kimi-k3",
    "openai-codex/gpt-5.6-luna",
    "opencode-go/deepseek-v4-flash",
    "opencode-go/gpt-5.6-luna",
    "xai-auth/grok-4.6",
    "opencode/grok-4.6",
    "opencode-go/glm-5.3",
    "opencode-go/qwen3.8-max",
    "opencode-go/deepseek-v4-pro",
    "openrouter/google/gemini-3.7-flash"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "opencode-go/qwen3.7-max",
        "thinking": "medium"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "worker": {
        "model": "opencode-go/kimi-k3",
        "thinking": "low",
        "fallbackModels": ["openai-codex/gpt-5.6-terra"]
      },
      "reviewer": {
        "model": "opencode-go/grok-4.5",
        "thinking": "high"
      },
      "context-builder": {
        "model": "opencode-go/kimi-k3",
        "thinking": "high"
      },
      "researcher": {
        "model": "opencode-go/qwen3.7-max",
        "thinking": "low"
      },
      "delegate": {
        "disabled": true
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "xhigh"
      }
    }
  },
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "markdown": {
    "mermaid": "streaming"
  },
  "packages": [
    "npm:@llblab/pi-telegram@0.39.3",
    "npm:pi-subagents@0.58.0",
    "npm:pi-mcp-adapter@2.29.0",
    "npm:pi-intercom@0.12.0",
    "npm:pi-schedule-prompt@0.4.1",
    "git:github.com/DietrichGebert/ponytail@2ed6c52c9d7e5e56942508591085fd45dea277d3",
    "npm:pi-prompt-template-model@0.12.1",
    "npm:@juicesharp/rpiv-web-tools@2.7.1",
    "npm:@juicesharp/rpiv-ask-user-question@2.7.1",
    "npm:@ff-labs/pi-fff@0.10.5",
    "npm:pi-xai-oauth@1.5.2"
  ]
}
