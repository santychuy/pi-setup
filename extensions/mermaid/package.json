{
  "name": "pi-mermaid-viewer",
  "version": "0.0.1",
  "description": "Render Mermaid diagrams from Pi user and assistant messages in the TUI",
  "keywords": [
    "mermaid",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/santychuy/pi-setup/tree/main/extensions/mermaid",
  "bugs": {
    "url": "https://github.com/santychuy/pi-setup/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santychuy/pi-setup.git",
    "directory": "extensions/mermaid"
  },
  "files": [
    "index.ts",
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "tsc --noEmit",
    "prepublishOnly": "tsdown --no-config --format esm --format cjs --dts --exports --clean --sourcemap --shims index.ts"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "mermaid": "11.15.0"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "tsdown": {
    "entry": [
      "index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
