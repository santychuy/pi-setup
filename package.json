{
  "name": "santychuy-pi-setup",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical source for Santychuy’s active Pi coding agent setup",
  "keywords": [
    "pi-package",
    "pi-setup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santychuy/pi-setup.git"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "check": "oxlint && oxfmt --check . && tsc --noEmit && bun run doctor --repo-only",
    "setup": "bun scripts/setup.ts",
    "doctor": "bun scripts/doctor.ts"
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  }
}
